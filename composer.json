{
    "name": "ksfraser/ksf-fa-manufacturer-consolidation",
    "description": "FrontAccounting Manufacturer Consolidation - MOQ rules, order consolidation, supplier minimums",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-common-db": "^1.0",
        "ksfraser/exceptions": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "ksfraser/famock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\FrontAccounting\\ManufacturerConsolidation\\": "src/Ksfraser/FrontAccounting/ManufacturerConsolidation/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\FrontAccounting\\ManufacturerConsolidation\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}